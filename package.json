{
  "name": "smart-learning-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:pwa": "tsc && vite build",
    "build:electron": "tsc && vite build --base=./",
    "electron:dev": "electron electron/main.js",
    "electron:build": "npm run build:electron && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.23.0",
    "zustand": "^4.5.2",
    "recharts": "^2.12.6",
    "lucide-react": "^0.511.0",
    "tailwind-merge": "^3.0.2",
    "react-quill": "^2.0.0",
    "uuid": "^14.0.0",
    "clsx": "^2.1.1",
    "axios": "^1.15.2",
    "cheerio": "^1.2.0",
    "katex": "^0.16.45"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@types/uuid": "^10.0.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.19.17",
    "@vitejs/plugin-react": "^4.2.1",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "tailwindcss": "^3.4.3",
    "postcss": "^8.4.38",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "vite-plugin-pwa": "^0.20.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "io.github.dch520438.smartlearning",
    "productName": "智慧学习系统",
    "directories": {
      "output": "electron-dist",
      "buildResources": "electron/assets"
    },
    "files": [
      "docs/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/assets/icon.ico"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "electron/assets/icon.png",
      "category": "Education"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
